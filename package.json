{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "description": "One place for a Solution Engineer to watch every Checkmarx One POV tenant: scans, failures, new projects and findings, refreshed every 10 minutes.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/launcher.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.mjs",
    "test": "node --test test/*.test.js",
    "serve": "node src/server.js",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "imapflow": "^2.12.1",
    "jszip": "^3.10.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "pptxgenjs": "^3.12.0"
  }
}
